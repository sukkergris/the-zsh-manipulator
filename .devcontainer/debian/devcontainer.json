{
  "name": "the-manipulator",

  "dockerComposeFile": "docker-compose.yml",

  "service": "dev",

  "workspaceFolder": "/xyz",
  "mounts": [
    "source=${localEnv:HOME}/.ssh,target=/home/container-user/.sshtemplate,type=bind,readonly,consistency=cached",
    "source=the-manipulator-claude-${localWorkspaceFolderBasename},target=/home/container-user/.claude,type=volume",
    "source=the-manipulator-continue-${localWorkspaceFolderBasename},target=/home/container-user/.continue,type=volume",
    // "source=the-manipulator-gh-${localWorkspaceFolderBasename},target=/home/container-user/.config/gh,type=volume",
    // Antigravity CLI: OAuth credentials live in ~/.gemini, so persisting it
    // means no re-login between devcontainer rebuilds.
    "source=the-manipulator-gemini-${localWorkspaceFolderBasename},target=/home/container-user/.gemini,type=volume"
  ],

  // Keep customizations for VS Code settings and extensions
  "customizations": {
    "vscode": {
      "settings": {
        // Set bash as the default terminal (installed in Dockerfile)
        "terminal.integrated.defaultProfile.linux": "zsh"
        // Optional Neovim integration path:
        // "vscode-neovim.neovimExecutablePaths.linux": "/usr/bin/nvim"
      },
      "extensions": [
        "ms-vscode-remote.remote-containers",
        "EditorConfig.EditorConfig",
        "task.vscode-task",
        "Anthropic.claude-code",
        "google.google-antigravity",
        "esbenp.prettier-vscode",
        "yzhang.markdown-all-in-one",
        "DavidAnson.vscode-markdownlint",
        "foxundermoon.shell-format",
        "timonwong.shellcheck",
        "ziglang.vscode-zig"
      ]
    }
  },

  // Runs once per container create, as remoteUser: fixes volume ownership,
  // sets up SSH and global npm tools, and reports Antigravity login status.
  "postCreateCommand": "bash .devcontainer/debian/post-container-install.sh",

  // The user VS Code should run as inside the service container.
  // Should match the user the service runs as (root in this case).
  "remoteUser": "container-user"
}
