FROM debian:trixie

# Use bash for the shell (default is sh)
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
# Set environment variables
ENV USERNAME=container-user \
    HOME_DIR="/home/container-user" \
    DOTNET_ROOT=/opt/dotnet \
    DEBIAN_FRONTEND=noninteractive \
    NODE_VERSION=24.11.1

# Update PATH once with all directories
ENV PATH="/usr/local/bin:/opt/dotnet:/opt/dotnet/tools:/home/container-user/.local/bin:/home/container-user/.dotnet/tools:$PATH"

# Install all system dependencies FIRST
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    # DON'T EVER INSTALL sudo FOR A PRODUCTION CONTAINER!
    sudo \
    python3 \
    python3-pip \
    python3-venv \
    gcc \
    libc6-dev \
    python3-dev \
    libffi-dev \
    libssl-dev \
    cargo \
    make \
    git \
    openssh-client \
    xclip \
    ripgrep \
    shellcheck \
    build-essential \
    bash \
    zsh \
    tree \
    stow \
    unzip \
    tmux \
    grep \
    jq \
    curl \
    wget \
    ca-certificates \
    gnupg \
    lsb-release && \
    rm -rf /var/lib/apt/lists/*

# Create non-root user AFTER sudo is installed
ARG USER_UID=1000
ARG USER_GID=1000
RUN groupadd --gid $USER_GID $USERNAME && \
    useradd --uid $USER_UID --gid $USER_GID --create-home --shell /bin/bash $USERNAME && \
    # Remove pw from every sudo making me able to play more. Requires sudo is installed. DON'T EVER USE FOR PRODUCTION!
    echo "$USERNAME ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Install latest nvim
RUN NVIM_FILE="nvim-linux-arm64.tar.gz" && \
    echo "Installing Neovim for ARM64 (Mac M3)..." && \
    curl -LO "https://github.com/neovim/neovim/releases/latest/download/${NVIM_FILE}" && \
    tar -C /opt -xzf "${NVIM_FILE}" && \
    rm "${NVIM_FILE}" && \
        # Link the binary to /usr/local/bin so it's globally available - remember to add '/usr/local/bin/' to path!
    ln -s /opt/nvim-linux-arm64/bin/nvim /usr/local/bin/nvim

ENV TASK_VERSION=v3.52.0
RUN TASK_URL="https://github.com/go-task/task/releases/download/${TASK_VERSION}/task_linux_arm64.tar.gz" && \
    curl -L "$TASK_URL" | tar -xz -C /usr/local/bin task

# Switch to non-root user for remaining setup
USER $USERNAME
WORKDIR $HOME_DIR

# Install nvm + Node and expose binaries system-wide
ENV NVM_DIR=/home/${USERNAME}/.nvm
RUN curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.3/install.sh | bash && \
    . "$NVM_DIR/nvm.sh" && \
    nvm install "$NODE_VERSION" && \
    nvm alias default "$NODE_VERSION" && \
    nvm use default && \
    # Node ships corepack, which provides yarn/pnpm on demand and honors each
    # project's "packageManager" field. Debian has no `yarn` package, so this
    # replaces what used to be an (always-failing) apt install.
    corepack enable && \
    node_bin="$NVM_DIR/versions/node/$(nvm version default)/bin" && \
    sudo ln -sf "$node_bin/node" /usr/local/bin/node && \
    sudo ln -sf "$node_bin/npm"  /usr/local/bin/npm && \
    sudo ln -sf "$node_bin/npx"  /usr/local/bin/npx && \
    sudo ln -sf "$node_bin/yarn" /usr/local/bin/yarn

# Install oh-my-zsh + powerlevel10k. Global npm tools and the Antigravity CLI
# are installed at container-create time instead (see .devcontainer/scripts/),
# so they land on persistent volumes and survive image rebuilds.
RUN sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" && \
    git clone --depth=1 https://github.com/romkatv/powerlevel10k.git $HOME_DIR/.oh-my-zsh/custom/themes/powerlevel10k

# Install the Antigravity CLI (`agy`).
#
# The upstream installer hardcodes $HOME/.local/bin, so install there and then
# move the binary to /usr/local/bin. That matters because ~/.local/bin must NOT
# be a Docker volume: a named volume mounted over a directory that already has
# content in the image hides the image's copy, which would make the baked-in
# binary vanish on the second container create.
#
# Credentials are a separate concern: `agy` keeps its OAuth token in ~/.gemini
# (jetski-standalone-oauth-token, google_accounts.json). That directory IS a
# named volume (see devcontainer.json), which is what keeps you logged in
# across devcontainer rebuilds.
RUN curl -fsSL https://antigravity.google/cli/install.sh | bash && \
    sudo mv "$HOME_DIR/.local/bin/agy" /usr/local/bin/agy && \
    sudo chmod 755 /usr/local/bin/agy && \
    /usr/local/bin/agy --help >/dev/null

# Install shellspec (test framework, see CLAUDE.md). Installs into
# $HOME_DIR/.local/bin via a plain symlink, no sudo/root needed; that
# directory is already on PATH (see the ENV PATH above) and is NOT a Docker
# volume (see devcontainer.json), so the baked-in binary survives container
# recreates.
RUN curl -fsSL https://git.io/shellspec | sh -s -- --yes && \
    shellspec --version

# Pre-create the dirs that get volume-mounted so they are owned by the
# non-root user rather than root when Docker creates them on first mount.
RUN mkdir -p $HOME_DIR/.local/bin \
             $HOME_DIR/.gemini \
             $HOME_DIR/.claude
            # $HOME_DIR/.config/gh
